type":"Skill","id":3960,"relatedIds":[3960,4119,4496,4560,4645,4569,4142,4625]},"tooltipIcon":"images/dzone/cards/portrait_card_curse_04.png","icon":"images/dzone/cards/portrait_card_curse_04.png"},"kw_d37654d4690f0de6":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 5.25의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_440fa9c412a10160":{"name":"힘","description":"상태 효과 | 힘\n\n이번 전투 내에서 주는 피해가 증가합니다.","source":{"type":"State","id":2900},"icon":"images/keyword-icons/inline/battle_card_buff_021.png","color":"#71aa86"},"kw_0fb2f54abb1fc3f0":{"name":"경계","description":"상태 효과 | 경계\n\n이번 전투 내에서 생성하는 실드가 6.75pt 증가한다.","source":{"type":"State","id":2403},"icon":"images/keyword-icons/inline/battle_card_buff_009.png","color":"#76aac8"},"kw_cc8c0a9d6b0760cf":{"name":"힘","description":"상태 효과 | 힘\n\n이번 턴 내에서 주는 능동 피해가 1.95pt 감소한다.","source":{"type":"State","id":3902},"icon":"images/keyword-icons/inline/battle_card_buff_037.png","color":"#af6bb0"},"kw_7f10c852d66d799f":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 3.25의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_2cb55b9a2af9e2f0":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 9.5의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_a756af3522f06507":{"name":"중독","description":"상태 효과 | 중독\n\n턴 종료 후, 스택 수 의 순수 피해를 받음.","source":{"type":"State","id":3068},"icon":"images/keyword-icons/inline/battle_card_buff_006.png","color":"#af6bb0"},"kw_72f332eaec5035df":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 7.75의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_fa64e3add67ee810":{"name":"손상","description":"상태 효과 | 손상\n\n획득하는 모든 실드가 (25 + 손상의 추가 방어막 감소율)% 감소한다.","source":{"type":"State","id":2564},"icon":"images/keyword-icons/inline/battle_card_buff_015.png","color":"#af6bb0"},"kw_9b3d545f85bc3985":{"name":"광란(발광)","description":"상태 효과 | 광란(발광)\n\n가하는 능동 피해 횟수가 1 증가.","source":{"type":"State","id":3259},"icon":"images/keyword-icons/inline/battle_card_buff_030.png","color":"#71aa86"},"kw_c620e239a14714cb":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 8.25의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_c4148b074761cdff":{"name":"허약","description":"상태 효과 | 허약\n\n가하는 능동 및 촉수 피해가 (25 + 허약의 추가 피해 감소율) % 감소.","source":{"type":"State","id":3469},"icon":"images/keyword-icons/inline/battle_card_buff_005.png","color":"#af6bb0"},"kw_854d3cf34fc3ce7b":{"name":"경련","description":"상태 카드 | 경련 · 산출력 0\n\n상태 카드.\n버릴 시 제거됨","source":{"type":"Skill","id":4826},"icon":"images/dzone/cards/portrait_card_state_skull.png"},"kw_12c0e78c2616b4d3":{"name":"「기절」","description":"상태 카드 | 「기절」 · 산출력 0\n\n상태 카드.\n버릴 시 제거됨","source":{"type":"Skill","id":4826},"icon":"images/dzone/cards/portrait_card_state_skull.png"},"kw_1ac959392003a522":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 6의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"},"kw_2167320a83e2edfb":{"name":"분노","description":"상태 효과 | 분노\n\n매 턴 종료 시 4.75의 힘을 획득한다.","source":{"type":"State","id":2433},"icon":"images/keyword-icons/original/icons_buff_016.png","color":"#c48662"}}}