{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carriepigeon",
  "main": "workers/feedback-worker.js",
  "compatibility_date": "2026-05-26",
  "keep_vars": true,
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "RESOURCE_LINK_STATE",
      "id": "6225ba1d64f34c05a063adf74a9782b9"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
